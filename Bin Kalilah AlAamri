                                <th class="p-3 font-semibold rounded-tr-lg">Operational Context</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            <tr class="hover:bg-slate-50">
                                <td class="p-3 font-medium text-slate-900">Ex-Works Factory Price</td>
                                <td class="p-3 text-center">63.56 SAR ($339/Ton)</td>
                                <td class="p-3 text-center font-semibold text-amber-900 bg-amber-50">59.81 SAR ($319/Ton)</td>
