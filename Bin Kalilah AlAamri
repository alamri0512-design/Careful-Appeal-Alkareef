        const COMPETITOR_CEILING = 86.00;

        let costChartInstance = null;
        let roiChartInstance = null;
        let currentSelectedOption = "Option 1: $1.00 Factory Support";

        // Initialize Charts on DOM Content Loaded
        document.addEventListener("DOMContentLoaded", function () {
            initCostChart();
            initRoiChart();
            setupSimulatorListeners();
            updateSimulator();
        });

        // Initialize Cost Breakdown Stacked Bar Chart
        function initCostChart() {
            const ctx = document.getElementById('costComparisonChart').getContext('2d');
            costChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Status Quo', 'Option 1 ($1 Support)', 'Option 2 (50% Customs)'],
                    datasets: [
                        {
                            label: 'Ex-Works Price (SAR)',
                            data: [63.56, 59.81, 63.56],
                            backgroundColor: '#1e293b'
                        },
                        {
                            label: 'Land Transport (SAR)',
                            data: [8.02, 8.02, 8.02],
                            backgroundColor: '#d97706'
                        },
                        {
                            label: 'Customs Duties (SAR)',
                            data: [15.70, 15.70, 7.85],
                            backgroundColor: '#dc2626'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { stacked: true },
                        y: { 
                            stacked: true,
                            max: 100,
                            ticks: {
                                callback: function(value) { return value + ' SAR'; }
                            }
                        }
                    },
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                        tooltip: {
                            callbacks: {
                                footer: function(tooltipItems) {
                                    let total = 0;
                                    tooltipItems.forEach(function(tooltipItem) {
                                        total += tooltipItem.raw;
                                    });
                                    return 'Total Landed: ' + total.toFixed(2) + ' SAR (Target Ceiling: 86.00 SAR)';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Initialize Action vs Inaction Financial Impact Chart
        function initRoiChart() {
            const ctx = document.getElementById('roiComparisonChart').getContext('2d');
            roiChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Monthly Support Outlay', 'Protected Monthly Export Revenue', 'Future Re-Acquisition Cost (If Lost)'],
                    datasets: [{
                        label: 'Financial Scale (USD $)',
                        data: [150000, 2400000, 1500000],
                        backgroundColor: ['#059669', '#1e293b', '#dc2626']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Value: $' + context.raw.toLocaleString() + ' USD';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            ticks: {
                                callback: function(value) {
                                    return '$' + (value / 1000) + 'k';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Simulator Setup & Event Listeners
        function setupSimulatorListeners() {
            document.getElementById('exworksDiscount').addEventListener('input', updateSimulator);
            document.getElementById('customsShare').addEventListener('input', updateSimulator);
            document.getElementById('monthlyVolume').addEventListener('input', updateSimulator);
        }

        // Simulator Recalculation Engine
        function updateSimulator() {
            const discountUSD = parseFloat(document.getElementById('exworksDiscount').value);
            const customsSharePct = parseFloat(document.getElementById('customsShare').value);
            const volumeBags = parseInt(document.getElementById('monthlyVolume').value);

            // Conversion 1 USD = 3.75 SAR
            const discountSAR = discountUSD * 3.75;
            const newExWorksSAR = BASE_EXWORKS_SAR - discountSAR;
            const newCustomsSAR = BASE_CUSTOMS_SAR * (1 - (customsSharePct / 100));

            const totalLandedSAR = newExWorksSAR + FREIGHT_SAR + newCustomsSAR;
            const gapVsCeiling = COMPETITOR_CEILING - totalLandedSAR;
            
            // Viable selling price (undercut ceiling by ~1.00 SAR if viable)
            let recommendedSellPrice = 85.00;
            if (totalLandedSAR < 83.00) {
                recommendedSellPrice = 84.00;
            } else if (totalLandedSAR >= 86.00) {
                recommendedSellPrice = totalLandedSAR;
            }

            const agentMargin = recommendedSellPrice - totalLandedSAR;
            const totalFactorySupportUSD = (discountUSD * volumeBags) + ((customsSharePct / 100 * BASE_CUSTOMS_SAR / 3.75) * volumeBags);

            // Update DOM Elements
            document.getElementById('exworksVal').innerText = `$${discountUSD.toFixed(2)} USD (${discountSAR.toFixed(2)} SAR)`;
            document.getElementById('customsVal').innerText = `${customsSharePct}%`;
            document.getElementById('volumeVal').innerText = `${volumeBags.toLocaleString()} Bags (${(volumeBags/20).toLocaleString()} Tons)`;

            document.getElementById('simLandedCost').innerHTML = `${totalLandedSAR.toFixed(2)} <span class="text-xs text-slate-300">SAR</span>`;
            
            const costStatusEl = document.getElementById('simCostStatus');
            if (gapVsCeiling > 0) {
                costStatusEl.className = "text-xs text-emerald-400 font-medium block";
                costStatusEl.innerText = `✓ ${gapVsCeiling.toFixed(2)} SAR Below Competitor Ceiling`;
            } else {
                costStatusEl.className = "text-xs text-red-400 font-medium block";
                costStatusEl.innerText = `✕ ${Math.abs(gapVsCeiling).toFixed(2)} SAR ABOVE Competitor Ceiling (Unviable)`;
            }

            document.getElementById('simSellPrice').innerHTML = `${recommendedSellPrice.toFixed(2)} <span class="text-xs text-slate-300">SAR</span>`;
            
            const marginEl = document.getElementById('simAgentMargin');
            if (agentMargin >= 0) {
                marginEl.className = "text-3xl font-extrabold text-emerald-400";
                marginEl.innerHTML = `+${agentMargin.toFixed(2)} <span class="text-xs text-slate-300">SAR/Bag</span>`;
            } else {
                marginEl.className = "text-3xl font-extrabold text-red-400";
                marginEl.innerHTML = `${agentMargin.toFixed(2)} <span class="text-xs text-slate-300">SAR/Bag</span>`;
            }

            document.getElementById('simTotalSupport').innerHTML = `$${Math.round(totalFactorySupportUSD).toLocaleString()} <span class="text-xs text-slate-300">USD/mo</span>`;
        }

        // Option Selection Handler
        function selectOption(optionName) {
            currentSelectedOption = optionName;
            document.getElementById('selectedOptionText').innerText = `Selected Directive: ${optionName}`;
            
            // Preset simulator controls based on selection
            if (optionName.includes("Option 1")) {
                document.getElementById('exworksDiscount').value = 1.00;
                document.getElementById('customsShare').value = 0;
            } else if (optionName.includes("Option 2")) {
                document.getElementById('exworksDiscount').value = 0.00;
                document.getElementById('customsShare').value = 50;
            } else if (optionName.includes("Option 3")) {
                document.getElementById('exworksDiscount').value = 1.25;
                document.getElementById('customsShare').value = 25;
            }
            updateSimulator();

            // Smooth scroll to summary box
            document.getElementById('selectionSummary').scrollIntoView({ behavior: 'smooth' });
        }

        // Confirm Directive Modal / Alert
        function confirmDirective() {
            alert(`Executive Directive Approved!\n\nDirective: ${currentSelectedOption}\nStatus: Signal transmitted to Export & Logistics Management.\nAction: Operations ready to resume immediately.`);
        }
    </script>
