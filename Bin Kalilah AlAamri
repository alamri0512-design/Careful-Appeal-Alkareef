        <!-- SECTION 2: COST MATHEMATICS & SCENARIO COMPARISON -->
        <section class="space-y-6">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-6">
                <div>
                    <h2 class="text-lg sm:text-xl font-bold text-navy-900">
                        📊 Mathematical Cost Structure & Support Scenarios
                    </h2>
                    <p class="text-sm text-slate-600 mt-1">
                        Breakdown of per-bag costs (50kg) comparing the current unviable model against the two primary factory support options.
                    </p>
                </div>

                <!-- TABLE OF SCENARIOS -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs sm:text-sm">
                        <thead>
                            <tr class="bg-navy-900 text-white">
