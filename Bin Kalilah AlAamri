<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-amber-500 selection:text-white">

    <!-- Chosen Palette: Executive Warm Neutral & Deep Navy (Navy #0f172a, Warm Amber #d97706, Emerald #059669, Crisp Slate #f8fafc) -->
