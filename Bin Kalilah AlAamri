                                <td class="p-3 text-center">8.02 SAR</td>
                                <td class="p-3 text-center bg-amber-50">8.02 SAR</td>
                                <td class="p-3 text-center">8.02 SAR</td>
                                <td class="p-3 text-slate-500">900 OMR per truck / 1,100 bags</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="p-3 font-medium text-slate-900">Yemeni Customs & Fees</td>
                                <td class="p-3 text-center text-red-600 font-semibold">15.70 SAR</td>
                                <td class="p-3 text-center bg-amber-50">15.70 SAR</td>
                                <td class="p-3 text-center text-emerald-700 font-semibold">7.85 SAR (50% Shared)</td>
                                <td class="p-3 text-slate-500">Circular 227 rate (410 YER/SAR)</td>
                            </tr>
                            <tr class="bg-slate-100 font-bold">
                                <td class="p-3 text-navy-900">Total Landed Cost</td>
                                <td class="p-3 text-center text-red-600 text-base">87.28 SAR</td>
                                <td class="p-3 text-center text-amber-800 text-base bg-amber-100">83.53 SAR</td>
                                <td class="p-3 text-center text-emerald-800 text-base">79.43 SAR</td>
                                <td class="p-3 text-navy-900">Landed truck-deck in Yemen</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="p-3 font-medium text-slate-900">Market Ceiling Price (Saudi/Local)</td>
                                <td class="p-3 text-center">86.00 SAR</td>
                                <td class="p-3 text-center bg-amber-50">86.00 SAR</td>
                                <td class="p-3 text-center">86.00 SAR</td>
                                <td class="p-3 text-slate-500">Competitor benchmark ceiling</td>
