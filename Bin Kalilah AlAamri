                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Option 1 Card -->
                <div class="border-2 border-amber-500 bg-amber-50/40 rounded-xl p-5 space-y-3 relative flex flex-col justify-between">
                    <span class="absolute -top-3 right-4 bg-amber-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">RECOMMENDED</span>
