            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center space-x-3 space-x-reverse">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-400 border border-amber-500/30">
                            URGENT EXECUTIVE ACTION
                        </span>
                        <span class="text-xs text-slate-400">Target: Salalah Mills Co. (S.A.O.G.) Executive Leadership</span>
                    </div>
                    <h1 class="text-xl md:text-2xl font-bold tracking-tight text-white mt-1">
                        Autumn Flour (Al-Khareef) — Yemen Market Recovery Briefing
