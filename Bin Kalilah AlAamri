                            <div id="simTotalSupport" class="text-3xl font-extrabold text-blue-400">$150,000 <span class="text-xs text-slate-300">USD/mo</span></div>
                            <span class="text-xs text-slate-300 block">Protects $2.4M+ Export Revenue</span>
                        </div>
                    </div>
                </div>
            </div>
