                                <span id="volumeVal" class="font-bold text-white">150,000 Bags (7,500 Tons)</span>
                            </div>
                            <input type="range" id="monthlyVolume" min="60000" max="200000" step="10000" value="150000" class="w-full accent-blue-500 cursor-pointer">
                            <div class="flex justify-between text-[10px] text-slate-400">
                                <span>60,000 Bags</span>
                                <span>150,000 Bags</span>
                                <span>200,000 Bags</span>
                            </div>
                        </div>
                    </div>

                    <!-- RESULTS SIDE (7 cols) -->
